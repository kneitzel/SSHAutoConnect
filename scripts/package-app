#!/usr/bin/env bash
set -euo pipefail
project_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$project_root"
maven_options=(-B -ntp)
while (($#)); do
    case "$1" in
        --skip-tests|--skip-build) maven_options+=(-DskipTests) ;;
        --help|-h)
            echo 'Usage: scripts/package-app [--skip-tests] [Maven options]'
            echo 'Builds a self-contained application image as part of the standard Maven install build.'
            echo '--skip-build is retained as an alias for --skip-tests; Maven still stages the current application.'
            exit 0 ;;
        *) maven_options+=("$1") ;;
    esac
    shift
done
exec ./mvnw "${maven_options[@]}" install
