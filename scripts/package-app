#!/usr/bin/env bash
set -euo pipefail
project_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$project_root"
maven_options=(-B -ntp -Pjpackage)
while (($#)); do
    case "$1" in
        --skip-tests|--skip-build) maven_options+=(-DskipTests) ;;
        --image-only) maven_options+=(-Djpackage.installer.skip=true) ;;
        --help|-h)
            echo 'Usage: scripts/package-app [--skip-tests] [--image-only] [Maven options]'
            echo 'Builds a bundled application and native installer using the jpackage Maven profile.'
            echo '--skip-build is retained as an alias for --skip-tests; Maven still stages the current application.'
            exit 0 ;;
        *) maven_options+=("$1") ;;
    esac
    shift
done
exec ./mvnw "${maven_options[@]}" verify
